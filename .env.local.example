# ============================================================================
# Infinity Web & Apps — Environment Variables
# ----------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in the values from your Supabase
# project (https://app.supabase.com  ->  Project Settings -> API).
#
# NEVER commit `.env.local`. The service-role key must ONLY ever be used on the
# server. It is never imported into a client component.
# ============================================================================

# --- Public (safe to expose to the browser) ---------------------------------
# Your Supabase project URL, e.g. https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Your Supabase anon/public key. This is safe for the browser: Row Level
# Security (RLS) policies in the database enforce what it may read/write.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The canonical public URL of the deployed site (used for auth redirects,
# sitemap, and metadata). e.g. https://infinitywebapps.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Server-only (NEVER exposed to the browser) -----------------------------
# Service-role key. Grants full DB access, bypassing RLS. Used only in
# server-side API routes (e.g. the rate-limited contact endpoint) so leads can
# be written even for anonymous visitors without weakening RLS. Keep secret.
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated list of admin emails that are allowed into /admin.
# A signed-in user whose email is in this list (or whose profile.role = 'admin')
# is treated as an administrator.
ADMIN_EMAILS=
